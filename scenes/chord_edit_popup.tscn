[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/chord_edit_popup.gd" id="1"]

[node name="ChordEditPopup" type="Window"]
title = "Edit Chord"
size = Vector2i(360, 440)
visible = false
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Pad 1"

[node name="TriggerRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="TriggerLabel" type="Label" parent="Margin/VBox/TriggerRow"]
layout_mode = 2
text = "Trigger"

[node name="TriggerValueLabel" type="Label" parent="Margin/VBox/TriggerRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "—"
horizontal_alignment = 1

[node name="LearnButton" type="Button" parent="Margin/VBox/TriggerRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Learn"

[node name="HSeparator0" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="ChordList" type="ItemList" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 96)
size_flags_vertical = 3

[node name="RemoveButton" type="Button" parent="Margin/VBox"]
layout_mode = 2
text = "Remove Selected"

[node name="HSeparator1" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="AddRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="NoteOption" type="OptionButton" parent="Margin/VBox/AddRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="OctaveSpin" type="SpinBox" parent="Margin/VBox/AddRow"]
unique_name_in_owner = true
layout_mode = 2
min_value = -2
max_value = 8
value = 3

[node name="AddNoteButton" type="Button" parent="Margin/VBox/AddRow"]
layout_mode = 2
text = "Add Note"

[node name="ChordGenRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="ChordTypeOption" type="OptionButton" parent="Margin/VBox/ChordGenRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
clip_text = true

[node name="GenerateChordButton" type="Button" parent="Margin/VBox/ChordGenRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Generate"
tooltip_text = "Fill the chord above from the root note + octave (left) and this chord type"

[node name="HSeparator2" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="VelocityRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="VelocityLabel" type="Label" parent="Margin/VBox/VelocityRow"]
layout_mode = 2
text = "Velocity"

[node name="VelocityModeOption" type="OptionButton" parent="Margin/VBox/VelocityRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="FixedVelocitySpin" type="SpinBox" parent="Margin/VBox/VelocityRow"]
unique_name_in_owner = true
layout_mode = 2
min_value = 0
max_value = 127
value = 100

[node name="ChannelRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="ChannelLabel" type="Label" parent="Margin/VBox/ChannelRow"]
layout_mode = 2
text = "Output Channel"

[node name="ChannelSpin" type="SpinBox" parent="Margin/VBox/ChannelRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
min_value = 1
max_value = 16
value = 1

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ButtonRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
alignment = 2

[node name="CancelButton" type="Button" parent="Margin/VBox/ButtonRow"]
layout_mode = 2
text = "Cancel"

[node name="SaveButton" type="Button" parent="Margin/VBox/ButtonRow"]
layout_mode = 2
text = "Save"

[connection signal="pressed" from="Margin/VBox/TriggerRow/LearnButton" to="." method="_on_learn_pressed"]
[connection signal="pressed" from="Margin/VBox/RemoveButton" to="." method="_on_remove_selected_pressed"]
[connection signal="pressed" from="Margin/VBox/AddRow/AddNoteButton" to="." method="_on_add_note_pressed"]
[connection signal="pressed" from="Margin/VBox/ChordGenRow/GenerateChordButton" to="." method="_on_generate_chord_pressed"]
[connection signal="pressed" from="Margin/VBox/ButtonRow/CancelButton" to="." method="_on_cancel_pressed"]
[connection signal="pressed" from="Margin/VBox/ButtonRow/SaveButton" to="." method="_on_save_pressed"]
